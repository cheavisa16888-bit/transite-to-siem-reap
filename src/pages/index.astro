---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const stats = [
  { value: '315 km', label: 'from Phnom Penh to Siem Reap', labelKm: 'ពីភ្នំពេញទៅសៀមរាប' },
  { value: '6 hours', label: 'by bus', labelKm: 'តាមឡានក្រុង' },
  { value: '45 min', label: 'by plane', labelKm: 'តាមយន្តហោះ' },
];

// Cost: '$' is cheapest, '$$$$' is most expensive.
const ways = [
  {
    icon: '🚌',
    name: 'Bus',
    nameKm: 'ឡានក្រុង',
    time: '6–7 hours',
    timeKm: '៦–៧ ម៉ោង',
    cost: '$',
    good: 'Cheap. Many buses every day.',
    goodKm: 'ថោក។ មានឡានក្រុងច្រើនរៀងរាល់ថ្ងៃ។',
    bad: 'Slow.',
    badKm: 'យឺត។',
  },
  {
    icon: '🌙',
    name: 'Night bus',
    nameKm: 'ឡានក្រុងពេលយប់',
    time: 'About 7 hours',
    timeKm: 'ប្រហែល ៧ ម៉ោង',
    cost: '$',
    good: 'Sleep on the bus and save a hotel night.',
    goodKm: 'គេងលើឡាន ហើយសន្សំថ្លៃសណ្ឋាគារមួយយប់។',
    bad: 'Some people find it hard to sleep.',
    badKm: 'មនុស្សខ្លះពិបាកគេង។',
  },
  {
    icon: '🚐',
    name: 'Minivan',
    nameKm: 'ឡានតូច (មីនីវ៉ាន)',
    time: '5–6 hours',
    timeKm: '៥–៦ ម៉ោង',
    cost: '$$',
    good: 'Faster than the bus.',
    goodKm: 'លឿនជាងឡានក្រុង។',
    bad: 'Small seats. It can be crowded.',
    badKm: 'កៅអីតូច។ អាចចង្អៀត។',
  },
  {
    icon: '🚕',
    name: 'Taxi',
    nameKm: 'តាក់ស៊ី',
    time: 'About 5 hours',
    timeKm: 'ប្រហែល ៥ ម៉ោង',
    cost: '$$$',
    good: 'Leave when you want. Stop where you want.',
    goodKm: 'ចេញពេលណាក៏បាន។ ឈប់កន្លែងណាក៏បាន។',
    bad: 'Expensive alone. Share it with friends.',
    badKm: 'ថ្លៃបើទៅម្នាក់ឯង។ ចែកគ្នាជាមួយមិត្តភក្តិ។',
  },
  {
    icon: '✈️',
    name: 'Plane',
    nameKm: 'យន្តហោះ',
    time: '45 min flight',
    timeKm: 'ហោះ ៤៥ នាទី',
    cost: '$$$$',
    good: 'The fastest way.',
    goodKm: 'មធ្យោបាយលឿនបំផុត។',
    bad: 'Most expensive. The new airport is about 1 hour from town.',
    badKm: 'ថ្លៃបំផុត។ អាកាសយានដ្ឋានថ្មីនៅឆ្ងាយពីទីក្រុងប្រហែល ១ ម៉ោង។',
  },
  {
    icon: '🚤',
    name: 'Boat',
    nameKm: 'ទូក',
    time: '5–6 hours',
    timeKm: '៥–៦ ម៉ោង',
    cost: '$$',
    good: 'Beautiful views of the Tonle Sap.',
    goodKm: 'ទេសភាពស្អាតនៃទន្លេសាប។',
    bad: 'Only some months, when the water is high.',
    badKm: 'មានតែខ្លះខែ ពេលទឹកឡើងខ្ពស់។',
  },
];

const tips = [
  {
    icon: '🎟️',
    title: 'Book early',
    titleKm: 'កក់មុន',
    text: 'On holidays like Khmer New Year and Pchum Ben, buy your ticket a few days before.',
    textKm: 'នៅថ្ងៃបុណ្យដូចជាចូលឆ្នាំខ្មែរ និងភ្ជុំបិណ្ឌ សូមទិញសំបុត្រមុនពីរបីថ្ងៃ។',
  },
  {
    icon: '💧',
    title: 'Bring water and snacks',
    titleKm: 'យកទឹក និងអាហារសម្រន់',
    text: 'The bus stops for food, but it’s good to have your own.',
    textKm: 'ឡានក្រុងឈប់សម្រាប់ញ៉ាំ ប៉ុន្តែល្អជាងបើមានរបស់ខ្លួនឯង។',
  },
  {
    icon: '🧥',
    title: 'Bring a jacket',
    titleKm: 'យកអាវរងា',
    text: 'The air-con on buses can be very cold.',
    textKm: 'ម៉ាស៊ីនត្រជាក់លើឡានក្រុងអាចត្រជាក់ខ្លាំង។',
  },
  {
    icon: '🛺',
    title: 'Tuk-tuk at the end',
    titleKm: 'តុកតុកនៅទីបញ្ចប់',
    text: 'Agree on the price before you get in.',
    textKm: 'ព្រមព្រៀងតម្លៃមុនពេលឡើងជិះ។',
  },
];

const sights = [
  {
    icon: '🌅',
    title: 'Angkor Wat',
    titleKm: 'អង្គរវត្ត',
    text: 'Come early to watch the sunrise.',
    textKm: 'មកពីព្រលឹមដើម្បីមើលថ្ងៃរះ។',
  },
  {
    icon: '🗿',
    title: 'Bayon',
    titleKm: 'ប្រាសាទបាយ័ន',
    text: 'The temple with many big stone faces.',
    textKm: 'ប្រាសាទដែលមានមុខថ្មធំៗជាច្រើន។',
  },
  {
    icon: '🌳',
    title: 'Ta Prohm',
    titleKm: 'ប្រាសាទតាព្រហ្ម',
    text: 'Giant tree roots growing over the temple.',
    textKm: 'ឫសឈើយក្សដុះគ្របលើប្រាសាទ។',
  },
  {
    icon: '🏮',
    title: 'Night market',
    titleKm: 'ផ្សាររាត្រី',
    text: 'Food, shops, and music in the evening.',
    textKm: 'អាហារ ហាង និងតន្ត្រីនៅពេលល្ងាច។',
  },
];

const route = [
  { place: 'Phnom Penh', placeKm: 'ភ្នំពេញ', icon: '🏙️' },
  { place: 'Kampong Thom', placeKm: 'កំពង់ធំ', icon: '🍜' },
  { place: 'Siem Reap', placeKm: 'សៀមរាប', icon: '🛕' },
];

const faqs = [
  {
    q: 'Which way is best?',
    qKm: 'តើមធ្យោបាយណាល្អបំផុត?',
    a: 'Bus to save money. Taxi for families or groups. Plane if you are in a hurry.',
    aKm: 'ឡានក្រុងបើចង់សន្សំលុយ។ តាក់ស៊ីសម្រាប់គ្រួសារ ឬក្រុម។ យន្តហោះបើអ្នកប្រញាប់។',
  },
  {
    q: 'Where do the buses leave from?',
    qKm: 'តើឡានក្រុងចេញពីណា?',
    a: 'Each bus company has its own station in Phnom Penh. Check your ticket.',
    aKm: 'ក្រុមហ៊ុនឡានក្រុងនីមួយៗមានស្ថានីយ៍ផ្ទាល់ខ្លួននៅភ្នំពេញ។ សូមពិនិត្យសំបុត្ររបស់អ្នក។',
  },
  {
    q: 'When is the best time to go?',
    qKm: 'តើពេលណាល្អបំផុតដើម្បីទៅ?',
    a: 'November to February. It is cooler, and there is little rain.',
    aKm: 'ខែវិច្ឆិកា ដល់ខែកុម្ភៈ។ អាកាសធាតុត្រជាក់ជាង ហើយមានភ្លៀងតិច។',
  },
  {
    q: 'Do I need a ticket for the temples?',
    qKm: 'តើខ្ញុំត្រូវការសំបុត្រដើម្បីចូលប្រាសាទទេ?',
    a: 'Foreign visitors need an Angkor Pass. Buy it at the official ticket office.',
    aKm: 'ភ្ញៀវបរទេសត្រូវការសំបុត្រ Angkor Pass។ ទិញវានៅការិយាល័យលក់សំបុត្រផ្លូវការ។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-brand"></span>
            A simple travel guide
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            From Phnom Penh to <span class="text-brand">Siem Reap</span>.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">ពីភ្នំពេញ ទៅសៀមរាប។</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Bus, minivan, taxi, plane, or boat? Compare them all, and get ready for your trip to Angkor.
            <span class="km" lang="km">ឡានក្រុង ឡានតូច តាក់ស៊ី យន្តហោះ ឬទូក? ប្រៀបធៀបទាំងអស់ ហើយត្រៀមខ្លួនសម្រាប់ដំណើររបស់អ្នកទៅអង្គរ។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#ways" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Compare the ways ↓ <span lang="km" class="font-khmer font-normal opacity-80">ប្រៀបធៀប</span>
            </a>
            <a href="#see" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              What to see → <span lang="km" class="font-khmer font-normal opacity-60">អ្វីដែលត្រូវមើល</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a ticket for the trip -->
        <div class="relative mx-auto w-full max-w-md" aria-hidden="true">
          <div class="rotate-[-2deg] rounded-3xl bg-white p-6 pb-12 shadow-2xl">
            <div class="flex items-center justify-between text-sm font-semibold text-muted">
              <span>TICKET · សំបុត្រ</span>
              <span>🚌</span>
            </div>
            <div class="mt-6 flex items-center justify-between gap-3">
              <div>
                <p class="font-display text-2xl leading-tight font-extrabold">Phnom<br />Penh</p>
                <p lang="km" class="font-khmer text-sm text-muted">ភ្នំពេញ</p>
              </div>
              <div class="flex flex-1 items-center gap-2 text-brand">
                <span class="h-0.5 flex-1 border-t-2 border-dashed border-brand/50"></span>
                <span class="text-2xl">➜</span>
              </div>
              <div class="text-right">
                <p class="font-display text-2xl leading-tight font-extrabold">Siem<br />Reap</p>
                <p lang="km" class="font-khmer text-sm text-muted">សៀមរាប</p>
              </div>
            </div>
            <div class="mt-6 grid grid-cols-3 gap-3 border-t-2 border-dashed border-ink/10 pt-4 text-sm">
              <div><p class="text-muted">Distance</p><p class="font-bold">315 km</p></div>
              <div><p class="text-muted">Road</p><p class="font-bold">NR 6</p></div>
              <div><p class="text-muted">Arrive</p><p class="font-bold">🛕 Angkor</p></div>
            </div>
          </div>
          <p class="absolute -right-2 -bottom-5 rotate-[4deg] rounded-full bg-sun px-5 py-2 font-display font-bold shadow-xl">
            Have a good trip! <span lang="km" class="font-khmer font-normal">ដំណើរល្អ!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- WAYS TO GO -->
    <section id="ways" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Ways to go <span lang="km" class="font-khmer font-normal">· មធ្យោបាយធ្វើដំណើរ</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Six ways to get there.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">មធ្យោបាយប្រាំមួយដើម្បីទៅដល់។</p>
      <p class="mt-4 text-muted">
        $ = cheap, $$$$ = expensive.
        <span class="km" lang="km">$ = ថោក, $$$$ = ថ្លៃ។</span>
      </p>
      <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          ways.map((w) => (
            <li class="flex flex-col rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
              <div class="flex items-start justify-between">
                <span class="text-4xl">{w.icon}</span>
                <span class="rounded-full bg-sun/30 px-3 py-1 font-display font-bold">{w.cost}</span>
              </div>
              <h3 class="mt-4 font-display text-2xl font-bold">
                {w.name}
                <span class="km text-lg" lang="km">{w.nameKm}</span>
              </h3>
              <p class="mt-2 font-semibold text-brand">
                ⏱️ {w.time} <span lang="km" class="font-khmer font-normal">· {w.timeKm}</span>
              </p>
              <p class="mt-4 text-sm">
                <span class="font-bold text-brand">👍 </span>{w.good}
                <span class="km text-muted" lang="km">{w.goodKm}</span>
              </p>
              <p class="mt-2 text-sm">
                <span class="font-bold text-leaf">👎 </span>{w.bad}
                <span class="km text-muted" lang="km">{w.badKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- THE ROUTE -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          Most people take <span class="text-sun">National Road 6</span>, through Kampong Thom.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          មនុស្សភាគច្រើនធ្វើដំណើរតាមផ្លូវជាតិលេខ ៦ កាត់តាមខេត្តកំពង់ធំ។
        </p>
        <ol class="mt-12 flex items-start justify-between gap-2">
          {
            route.map((r, i) => (
              <li class="relative flex flex-1 flex-col items-center">
                {i > 0 && <span class="absolute top-7 right-1/2 w-full border-t-2 border-dashed border-paper/30" />}
                <span class="relative grid size-14 place-items-center rounded-full bg-paper text-2xl">{r.icon}</span>
                <span class="mt-3 font-display font-bold">{r.place}</span>
                <span lang="km" class="font-khmer text-sm text-paper/70">{r.placeKm}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- TIPS -->
    <section id="tips" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Tips <span lang="km" class="font-khmer font-normal">· គន្លឹះ</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Before you go.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">មុនពេលអ្នកចេញដំណើរ។</p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          tips.map((t) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{t.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {t.title}
                <span class="km text-base" lang="km">{t.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {t.text}
                <span class="km" lang="km">{t.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- WHAT TO SEE -->
    <section id="see" class="scroll-mt-20 bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">When you arrive <span lang="km" class="font-khmer font-normal">· ពេលអ្នកមកដល់</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">What to see in Siem Reap</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">អ្វីដែលត្រូវមើលនៅសៀមរាប</p>
          <a href="/angkor" class="mt-8 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
            🛕 Plan your day at Angkor Wat → <span lang="km" class="font-khmer font-normal opacity-80">ផែនការអង្គរវត្ត</span>
          </a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            sights.map((s) => (
              <li class="rounded-2xl bg-paper p-6">
                <span class="text-3xl">{s.icon}</span>
                <h3 class="mt-3 font-display text-lg font-bold">
                  {s.title}
                  <span class="km text-base" lang="km">{s.titleKm}</span>
                </h3>
                <p class="mt-1 text-muted">
                  {s.text}
                  <span class="km" lang="km">{s.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">
                {f.a}
                <span class="km" lang="km">{f.aKm}</span>
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Have a good trip! 🛕</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">សូមឱ្យដំណើរកម្សាន្តរបស់អ្នករីករាយ!</p>
        <a href={`mailto:${site.contactEmail}`} class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Ask me a question → <span lang="km" class="font-khmer font-normal">សួរខ្ញុំ</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
